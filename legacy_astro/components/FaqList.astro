---
const { items, heading = null } = Astro.props;
---

{heading && <h2 class="t-title" style="margin-bottom:1.5rem;">{heading}</h2>}

<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary>
        <span class="t-sub">{item.q}</span>
        <span class="faq__sign" aria-hidden="true"></span>
      </summary>
      <div class="faq__a"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq__item { border-top: 1px solid var(--border); }
  .faq__item:last-child { border-bottom: 1px solid var(--border); }

  .faq__item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    min-height: 48px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }

  .faq__sign {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 0.4rem;
  }
  .faq__sign::before,
  .faq__sign::after {
    content: "";
    position: absolute;
    background: var(--accent);
    transition: transform 0.25s ease;
  }
  .faq__sign::before { top: 7.5px; left: 0; width: 16px; height: 1.5px; }
  .faq__sign::after { left: 7.5px; top: 0; width: 1.5px; height: 16px; }
  .faq__item[open] .faq__sign::after { transform: scaleY(0); }

  .faq__a { padding: 0 0 1.5rem; max-width: 62ch; }
  .faq__a p { margin: 0; color: var(--ink-dim); }
</style>
