---
import { whatsappHref } from "../data/site.js";
---

<a
  href={whatsappHref}
  class="wa-float"
  target="_blank"
  rel="noopener"
  data-track="whatsapp-click"
  aria-label="Chat with Kool Konsulting on WhatsApp"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.94 9.94 0 0 0 4.84 1.23h.01c5.5 0 9.96-4.46 9.96-9.96C22 6.46 17.54 2 12.04 2Zm0 18.2h-.01a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.09.81.82-3.01-.2-.31a8.22 8.22 0 0 1-1.27-4.4c0-4.55 3.7-8.25 8.26-8.25a8.2 8.2 0 0 1 8.24 8.25c0 4.56-3.7 8.24-8.25 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.24-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.24.25-.4.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.83-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.47-.01a.9.9 0 0 0-.65.3c-.22.24-.86.84-.86 2.05 0 1.2.88 2.37 1 2.53.12.16 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z" />
  </svg>
</a>

<div class="sticky-cta" id="stickyCta" data-show="false">
  <div class="sticky-cta__in">
    <span class="sticky-cta__txt">Free 30-minute consultation. Reply within one working day.</span>
    <a href="/contact" class="btn" style="min-height:44px;padding:0.55rem 1.3rem;font-size:0.875rem;">
      Book a free call
    </a>
  </div>
</div>

<style>
  .sticky-cta__txt {
    font-size: 0.9375rem;
    color: rgba(20, 19, 15, 0.86);
  }
  @media (max-width: 640px) {
    .sticky-cta__txt { display: none; }
    .sticky-cta__in { justify-content: center; }
    .sticky-cta__in .btn { width: 100%; }
  }
</style>

<script>
  // Progressive enhancement only: the bar is a duplicate route to /contact,
  // which is already reachable from the header and every page body.
  const bar = document.getElementById("stickyCta");
  if (bar) {
    let shown = false;
    const onScroll = () => {
      const should = window.scrollY > 400;
      if (should !== shown) {
        shown = should;
        bar.dataset.show = String(should);
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Conversion tracking. Fires into Plausible when present; harmless otherwise.
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest("[data-track]") : null;
    if (!el) return;
    const name = el.getAttribute("data-track");
    if (window.plausible) window.plausible(name);
  });
</script>
