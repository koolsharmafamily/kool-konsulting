---
// Two mirrored K's on a shared axis; the four arms meet at top- and
// bottom-centre so the negative space resolves into a diamond.
const { withWordmark = true, height = "26" } = Astro.props;
---

<span style="display:flex;align-items:center;gap:0.65rem;">
  <svg
    height={height}
    viewBox="0 0 100 88"
    fill="none"
    aria-hidden="true"
    style="flex-shrink:0;width:auto;"
  >
    <g stroke="currentColor" stroke-width="7.5" stroke-linecap="square">
      <path d="M14 8 V80" />
      <path d="M14 44 L50 8" />
      <path d="M14 44 L50 80" />
      <path d="M86 8 V80" />
      <path d="M86 44 L50 8" />
      <path d="M86 44 L50 80" />
    </g>
  </svg>
  {withWordmark && (
    <span
      style="font-family:var(--font-display);font-size:1.3rem;letter-spacing:-0.02em;line-height:1;white-space:nowrap;"
      >Kool Konsulting</span
    >
  )}
</span>
