# Canonical origin. Keep default until the owned domain is connected.
NEXT_PUBLIC_SITE_URL=https://kool-konsulting.vercel.app
# Optional real scheduler. HTTPS URL. Link opens provider; a click is never confirmation.
BOOKING_URL=
CONTACT_EMAIL=
# Email delivery (all three needed). LEAD_FROM must be a verified sender.
RESEND_API_KEY=
LEAD_INBOX=
LEAD_FROM=
# Optional HTTPS webhook delivery, or fallback if email is not accepted.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

